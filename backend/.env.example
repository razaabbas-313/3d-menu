# Leave DB_URL unset to use the built-in H2 file database (no install needed).
# For PostgreSQL:
# DB_URL=jdbc:postgresql://localhost:5432/atelier_ar
# DB_USERNAME=postgres
# DB_PASSWORD=replace_me

# Required in production: a long random string (32+ chars).
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Where uploaded photos and 3D models are stored.
STORAGE_DIR=uploads
