# Database: Leave DB_URL unset to use built-in H2 file database locally.
# For managed PostgreSQL (Neon / Supabase / Render / self-hosted):
# DB_URL=jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_postgres_password
# DDL_AUTO=validate

# Required in production: a long random secret (32+ chars, e.g. openssl rand -hex 32).
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_TTL_DAYS=14

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.pages.dev

# Storage provider: "local" (default for local dev) or "s3" (required for ephemeral cloud hosting)
STORAGE_PROVIDER=local
STORAGE_DIR=uploads
MAX_MODEL_MB=15
STORAGE_QUOTA_MB=100

# AWS S3 & CloudFront Configuration (Required when STORAGE_PROVIDER=s3)
AWS_REGION=ap-south-1
S3_BUCKET=atelier-ar-bucket
# S3_PUBLIC_BASE_URL: CloudFront distribution URL (recommended) or left blank for presigned URLs
S3_PUBLIC_BASE_URL=https://d3v0d0550ieqxu.cloudfront.net
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# 3D Model Optimization Configuration
APP_OPTIMIZATION_ENABLED=true
APP_OPTIMIZATION_MODEL_COMPRESS=draco
APP_OPTIMIZATION_MODEL_TEXTURE_COMPRESS=webp
APP_OPTIMIZATION_MODEL_TEXTURE_SIZE=2048
APP_OPTIMIZATION_MODEL_TIMEOUT_SECONDS=90
