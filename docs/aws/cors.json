[
  {
    "AllowedHeaders": [
      "*"
    ],
    "AllowedMethods": [
      "GET",
      "HEAD",
      "PUT"
    ],
    "AllowedOrigins": [
      "https://*.pages.dev",
      "https://*.vercel.app",
      "https://*.cloudfront.net",
      "https://*.onrender.com",
      "http://localhost:5173",
      "http://localhost:3000",
