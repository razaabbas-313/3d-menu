{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPublicReadForAssetsAndSnapshots",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME/restaurants/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/models/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/images/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/public/*"
      ]
    }
  ]
}
