{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AtelierStorageObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::atelier-ar-bucket/restaurants/*",
        "arn:aws:s3:::atelier-ar-bucket/models/*",
        "arn:aws:s3:::atelier-ar-bucket/images/*",
        "arn:aws:s3:::atelier-ar-bucket/public/*"
      ]
    },
    {
      "Sid": "AtelierStorageBucketListingForQuota",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::atelier-ar-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "restaurants/*",
            "models/*",
            "images/*",
            "public/*"
          ]
        }
      }
    }
  ]
}
