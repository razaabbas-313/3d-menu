# ==============================================================================
# Atelier AR - Environment Configuration
# ==============================================================================

# ---- Server & Networking -----------------------------------------------------
PORT=8080
# Comma-separated list of origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173,https://*.pages.dev,https://*.vercel.app

# ---- Authentication & Security ----------------------------------------------
# 32+ characters secret for JWT tokens (Generate: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_secure_random_32_character_secret_key_in_production
JWT_TTL_DAYS=14

# ---- Database ----------------------------------------------------------------
# Leave blank for local dev (uses embedded H2 file database at ./data/atelier)
# For production PostgreSQL (Supabase / Neon / Render / self-hosted):
# DB_URL=jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_postgres_password
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ---- Storage Provider (local | s3) -------------------------------------------
# "local" saves uploads to local disk (default for local development)
# "s3" saves uploads to AWS S3 / CloudFront (required for cloud hosting with ephemeral disks)
STORAGE_PROVIDER=local
STORAGE_DIR=uploads
MAX_MODEL_MB=15
STORAGE_QUOTA_MB=100

# ---- AWS S3 Configuration (Required when STORAGE_PROVIDER=s3) ----------------
AWS_REGION=ap-south-1
S3_BUCKET=atelier-ar-bucket
# S3_PUBLIC_BASE_URL: either CloudFront URL or S3 bucket URL
S3_PUBLIC_BASE_URL=https://d3v0d0550ieqxu.cloudfront.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
