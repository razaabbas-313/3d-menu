# ==============================================================================
# Atelier AR - Production Environment Configuration
# ==============================================================================

# PostgreSQL Database Password
DB_PASSWORD=change_this_to_a_secure_postgres_password

# JWT Authentication Secret Key (32+ hex characters)
# Generate on Linux/Mac: openssl rand -hex 32
# Or generate on Windows PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
JWT_SECRET=generate_a_random_32_byte_hex_string_for_production_here

# Public Domain Origins for CORS (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
